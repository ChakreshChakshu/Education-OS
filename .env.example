# ==============================================================================
# Education Operating System (EOS) - Environment Variables Specification
# ==============================================================================

# Database Connectivity (Neon PostgreSQL Cloud - Direct Connection Required)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 Object Storage (Zero Local Storage Fallback)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=education-os-media
R2_PUBLIC_DOMAIN=https://media.educationos.dev

# Resend Transactional Email Provider
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=EducationOS <onboarding@resend.dev>

# Application Routing & Ports
PORT=3001
API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=super_secret_jwt_entropy_key_change_in_production
NODE_ENV=development
